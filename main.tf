
locals {
  region = var.region

  aws_profile = "${var.name_prefix}-${var.env}"

  # arn:aws:events:<region>::event-source/aws.partner/stripe.com/<id> -> aws.partner/stripe.com/<id>
  stripe_partner_event_source_name = split(
    "event-source/",
    stripe_v2_core_event_destination.aws_eventbridge_webhook.amazon_eventbridge[0].aws_event_source_arn
  )[1]

  # Shared by all Lambdas and layers here. Must match --python-version / --platform in layers/build.sh
  lambda_runtime      = "python3.14"
  lambda_architecture = "arm64"

  # S3 Tables namespace holding raw Stripe data (lowercase letters, digits and underscores only)
  stripe_raw_namespace = "stripe_raw_${var.env}"

  # One pip layer per dependency group in lambdas/pyproject.toml (except dev); must list the same groups
  pip_layers = ["duckdb", "stripe"]

  # Shared layers built by layers/build.sh: layer key => layer name prefix
  layers = merge(
    { for g in local.pip_layers : g => "${g}-python" },
    { "duckdb-extensions" = "duckdb-extensions" },
  )

  # Bundled into every Lambda zip next to the handler: import as `common.*` / read as iceberg/<table>.json
  lambda_additional_dirs = {
    common  = "${path.module}/lambdas/common"
    iceberg = "${path.module}/.build/stripe_openapi/iceberg" # Iceberg table schemas generated by tools/stripe_to_iceberg (build.sh)
  }

  lambda_layers = [module.layers["stripe"].arn, module.layers["duckdb"].arn, module.layers["duckdb-extensions"].arn]

  lambda_env_vars = {
    ssm_param_store_stripe_api_key = data.aws_ssm_parameter.stripe_api_key.name
    s3_table_bucket_arn            = module.subscription_data.table_bucket_arn
    s3_table_stripe_raw_namespace  = module.subscription_data.namespaces[local.stripe_raw_namespace]
    duckdb_extension_directory     = "/opt/duckdb_extensions" # duckdb-extensions layer, see layers/build.sh
  }
}

resource "stripe_product" "subscription" {
  name        = "Example Subscription"
  description = "Example per-seat subscription"
}

resource "random_string" "random_price_lookup_key_suffix" {
  length  = 3
  special = false
}

resource "stripe_price" "monthly" {
  product  = stripe_product.subscription.id
  currency = "usd"

  lookup_key = "per_seat_pricing_${random_string.random_price_lookup_key_suffix.result}"

  billing_scheme = "tiered"
  tiers_mode     = "volume"

  recurring {
    interval = "month"
  }

  # Example volume pricing (amounts in cents): flat fee up to 5 and 10 seats, per seat above that
  tiers {
    up_to       = 5
    flat_amount = 1000
  }

  tiers {
    up_to       = 10
    flat_amount = 1800
  }

  tiers {
    up_to       = "inf"
    unit_amount = 150
  }
}

resource "stripe_v2_core_event_destination" "aws_eventbridge_webhook" {
  name = "AWS EventBridge ${var.env}"

  enabled_events = [
    "v1.customer.subscription.created",
    "v1.customer.subscription.updated",
    "v1.customer.subscription.deleted",
  ]
  # thin: unversioned payload with only a reference to the subscription; the Lambda fetches its current state
  event_payload = "thin"
  type          = "amazon_eventbridge"

  amazon_eventbridge {
    aws_account_id = data.aws_caller_identity.current.account_id
    aws_region     = local.region
  }
}

# Provider resource is still named cloudwatch_event_*; this is the EventBridge partner event bus
# -> Creating this will programmatically associate the partner event source with the bus
resource "aws_cloudwatch_event_bus" "eventbridge_stripe_partner" {
  name              = local.stripe_partner_event_source_name
  description       = "EventBridge partner event bus"
  event_source_name = local.stripe_partner_event_source_name
}

# Now sending received events to the stripe events queue (-> Lambda) via EventBridge rules
resource "aws_cloudwatch_event_rule" "stripe_event_bus_to_lambda" {
  name           = "stripe_event_bus_to_lambda"
  event_bus_name = aws_cloudwatch_event_bus.eventbridge_stripe_partner.name

  event_pattern = jsonencode({
    source : [{
      "prefix" : "aws.partner/stripe.com"
    }]
  })
}

# The whole EventBridge event (envelope + thin Stripe event in detail) becomes the SQS message body
resource "aws_cloudwatch_event_target" "sqs_target" {
  rule = aws_cloudwatch_event_rule.stripe_event_bus_to_lambda.name
  arn  = aws_sqs_queue.stripe_events.arn

  event_bus_name = aws_cloudwatch_event_bus.eventbridge_stripe_partner.name
}

########### Stripe events queue ##########################
# EventBridge -> SQS -> stripe_events_lambda in batches, so one invocation upserts many subscriptions in one Iceberg
# commit, with a bounded number of concurrent writers and a DLQ for failing events

locals {
  stripe_events_lambda_timeout_seconds = 300

  stripe_events_queue = {
    # Lambda deletes a batch's messages when the invocation succeeds; a message not deleted (failed / timed out) becomes
    # visible again after this long, so this is the retry delay. AWS: >= 6x the function timeout
    visibility_timeout_seconds = 6 * local.stripe_events_lambda_timeout_seconds
    message_retention_seconds  = 8 * 24 * 3600
    # Receives (one per delivery of a message, failed batch or throttled) before the message moves to the DLQ
    max_receive_count = 5
    # For standard queues a message expires counting from its ORIGINAL enqueue time, also in the DLQ: keep >= main
    dlq_message_retention_seconds = 14 * 24 * 3600

    # Event source mapping
    batch_size                         = 100 # messages per invocation (deduped by subscription id by the Lambda)
    maximum_batching_window_in_seconds = 10  # collects messages this long before invoking, unless batch_size is reached
    maximum_concurrency                = 2   # concurrent invocations by this mapping (AWS minimum is 2)
  }
}

resource "aws_sqs_queue" "stripe_events_dlq" {
  name                      = "stripe-events-dlq-${var.env}"
  message_retention_seconds = local.stripe_events_queue.dlq_message_retention_seconds
  sqs_managed_sse_enabled   = true
}

resource "aws_sqs_queue" "stripe_events" {
  name                       = "stripe-events-${var.env}"
  visibility_timeout_seconds = local.stripe_events_queue.visibility_timeout_seconds
  message_retention_seconds  = local.stripe_events_queue.message_retention_seconds
  sqs_managed_sse_enabled    = true

  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.stripe_events_dlq.arn
    maxReceiveCount     = local.stripe_events_queue.max_receive_count
  })
}

data "aws_iam_policy_document" "stripe_events_queue" {
  statement {
    sid       = "AllowStripeEventBridgeRule"
    actions   = ["sqs:SendMessage"]
    resources = [aws_sqs_queue.stripe_events.arn]

    principals {
      type        = "Service"
      identifiers = ["events.amazonaws.com"]
    }

    condition {
      test     = "ArnEquals"
      variable = "aws:SourceArn"
      values   = [aws_cloudwatch_event_rule.stripe_event_bus_to_lambda.arn]
    }
  }
}

resource "aws_sqs_queue_policy" "stripe_events" {
  queue_url = aws_sqs_queue.stripe_events.id
  policy    = data.aws_iam_policy_document.stripe_events_queue.json
}

resource "aws_lambda_event_source_mapping" "stripe_events" {
  event_source_arn = aws_sqs_queue.stripe_events.arn
  function_name    = module.stripe_events_lambda.lambda_arn

  batch_size                         = local.stripe_events_queue.batch_size
  maximum_batching_window_in_seconds = local.stripe_events_queue.maximum_batching_window_in_seconds

  scaling_config {
    maximum_concurrency = local.stripe_events_queue.maximum_concurrency
  }

  # The Lambda returns batchItemFailures: only those messages go back to the queue, the rest of the batch is deleted
  function_response_types = ["ReportBatchItemFailures"]

  # The SQS permissions live in the module (execution role policy); the mapping validates them on create
  depends_on = [module.stripe_events_lambda]
}

#########################################################

########### Lambda Layers  ###############################

# Shared across all Lambdas in this deployment.
# Layer contents are built by layers/build.sh — run it before `tofu plan`
module "layers" {
  source   = "./modules/lambda/layer"
  for_each = local.layers

  layer_name               = "${each.value}-${var.env}"
  source_dir_path          = "${path.module}/.build/layers/${each.key}"
  target_zip_file_path     = "${path.module}/.build/layers/${each.key}.zip"
  compatible_runtimes      = [local.lambda_runtime]
  compatible_architectures = [local.lambda_architecture]

}

#########################################################

########### Lambdas #####################################

# Permissions shared by every Lambda here; attach function-specific ones as a separate policy
data "aws_iam_policy_document" "lambda_shared" {
  statement {
    sid       = "ReadStripeApiKey"
    actions   = ["ssm:GetParameter"]
    resources = [data.aws_ssm_parameter.stripe_api_key.arn]
  }

  # Iceberg REST catalog + table data access used by duckdb
  statement {
    sid = "ReadWriteS3Tables"
    actions = [
      "s3tables:GetTableBucket",
      "s3tables:ListNamespaces",
      "s3tables:GetNamespace",
      "s3tables:ListTables",
      "s3tables:CreateTable",
      "s3tables:GetTable",
      "s3tables:GetTableMetadataLocation",
      "s3tables:UpdateTableMetadataLocation",
      "s3tables:GetTableData",
      "s3tables:PutTableData",
    ]
    resources = [
      module.subscription_data.table_bucket_arn,
      "${module.subscription_data.table_bucket_arn}/table/*",
    ]
  }
}

resource "aws_iam_policy" "lambda_shared" {
  name   = "${var.name_prefix}-lambda-shared-${var.env}"
  policy = data.aws_iam_policy_document.lambda_shared.json
}

module "reconciliation_lambda" {
  source = "./modules/lambda/function"

  function_name        = "reconciliation-lambda-${var.env}"
  source_file_path     = "${path.module}/lambdas/reconciliation/reconciliation_lambda.py"
  target_zip_file_path = "${path.module}/.build/lambdas/reconciliation.zip"
  runtime              = local.lambda_runtime
  architecture         = local.lambda_architecture
  handler              = "reconciliation_lambda.lambda_handler"
  layers               = local.lambda_layers
  additional_dirs      = local.lambda_additional_dirs

  # Load test: 1024 MB peaked at 1010-1023 MB with 20-40k rows and stalled a MERGE at 40k (timeout). Each batch joins
  # against the whole table, so memory grows with it; more memory is also more vCPU (MERGE is CPU-bound).
  # 3008 = this account's current Lambda memory limit (UpdateFunctionConfiguration rejects more; quota increase needed)
  memory_size_mb  = 3008
  timeout_seconds = 900 # Lambda maximum (15 minutes)

  schedule_expression = {
    dev  = "cron(0 2 ? * MON *)"  # 02:00 UTC every Monday
    prod = "cron(0 2,10 * * ? *)" # 02:00 and 10:00 UTC daily
  }[var.env]

  env_vars            = local.lambda_env_vars
  managed_policy_arns = [aws_iam_policy.lambda_shared.arn]
}

module "stripe_events_lambda" {
  source = "./modules/lambda/function"

  function_name        = "stripe-events-lambda-${var.env}"
  source_file_path     = "${path.module}/lambdas/stripe_events/stripe_events_lambda.py"
  target_zip_file_path = "${path.module}/.build/lambdas/stripe_events.zip"
  runtime              = local.lambda_runtime
  architecture         = local.lambda_architecture
  handler              = "stripe_events_lambda.lambda_handler"
  layers               = local.lambda_layers
  additional_dirs      = local.lambda_additional_dirs

  memory_size_mb  = 2048 # load test: 1024 MB reached 694 MB at 40k rows and kept growing; 2048 is also a full vCPU
  timeout_seconds = local.stripe_events_lambda_timeout_seconds

  env_vars            = local.lambda_env_vars
  managed_policy_arns = [aws_iam_policy.lambda_shared.arn]

  # Polled by aws_lambda_event_source_mapping.stripe_events
  additional_iam_policy_statements = [{
    sid       = "ConsumeStripeEventsQueue"
    actions   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
    resources = [aws_sqs_queue.stripe_events.arn]
  }]
}
#########################################################

####################### S3 Storage #######################

module "subscription_data" {
  source = "./modules/s3_table"

  bucket_name = "${var.name_prefix}-subscription-data"

  #table schemas are managed by Lambda, because although you can define S3 table schema in terraform, their subsequent schema update triggers table drop + create (crazy work)
  namespace_to_tables = {
    (local.stripe_raw_namespace) = {}
    test                         = {}
  }
}

# S3 Tables <-> AWS analytics integration (same as console "Enable integration").
# Mounts every table bucket in this region as s3tablescatalog/<bucket> so Athena etc. can query them;
# access stays governed by IAM only (ALL -> IAM_ALLOWED_PRINCIPALS)
resource "aws_glue_catalog" "s3tables" {
  name = "s3tablescatalog"

  federated_catalog {
    identifier      = "arn:aws:s3tables:${local.region}:${data.aws_caller_identity.current.account_id}:bucket/*"
    connection_name = "aws:s3tables"
  }

  create_database_default_permissions {
    permissions = ["ALL"]
    principal {
      data_lake_principal_identifier = "IAM_ALLOWED_PRINCIPALS"
    }
  }

  create_table_default_permissions {
    permissions = ["ALL"]
    principal {
      data_lake_principal_identifier = "IAM_ALLOWED_PRINCIPALS"
    }
  }
}

